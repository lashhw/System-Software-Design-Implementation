+SYSCALL_DEFINE1(remap_page_table, struct expose_pgtbl_args __user *, args)
+{
+	struct expose_pgtbl_args kargs;
+	int ret = 0;
+
+	struct task_struct *target_task = NULL;
+	struct mm_struct *target_mm = NULL;
+	struct vm_area_struct *vma = NULL;
+
+	pgd_t *pgd_va;
+	unsigned long pgd_pa;
+
+	unsigned long pfn_to_map;
+
+	if (copy_from_user(&kargs, args, sizeof(kargs))) {
+		pr_err("remap_page_table: failed to copy arguments from userspace\n");
+		return -EFAULT;
+	}
+
+	pr_info("remap_page_table: called with args:\n");
+	pr_info("  pid         = %d\n", kargs.pid);
+	pr_info("  remap_vaddr = 0x%lx\n", kargs.remap_vaddr);
+	pr_info("  pfn         = 0x%lx\n", kargs.pfn);
+	pr_info("  level       = %u\n", kargs.level);
+
+	if (kargs.level > 3) {
+		pr_err("remap_page_table: invalid level\n");
+		return -EINVAL;
+	}
+
+	if (kargs.remap_vaddr & ~PAGE_MASK) {
+		pr_err("remap_page_table: remap_vaddr not aligned\n");
+		return -EINVAL;
+	}
+
+	target_task = find_task_by_vpid(kargs.pid);
+	if (!target_task) {
+		pr_err("remap_page_table: target pid not found\n");
+		return -EINVAL;
+	}
+
+	target_mm = get_task_mm(target_task);
+	if (!target_mm) {
+		pr_err("remap_page_table: target pid has no mm_struct\n");
+		ret = -EINVAL;
+		goto out_put_task;
+	}
+
+	if (kargs.level == 0) {
+		pgd_va = target_mm->pgd;
+		if (!pgd_va) {
+			pr_err("remap_page_table: target mm has no pgd\n");
+			ret = -EINVAL;
+			goto out_put_mm;
+		}
+		pgd_pa = virt_to_phys((void *)pgd_va);
+		pfn_to_map = pgd_pa >> PAGE_SHIFT;
+		pr_info("remap_page_table: target pgd virt=0x%lx, phys=0x%lx, pfn=0x%lx\n",
+				(unsigned long)pgd_va, pgd_pa, pfn_to_map);
+	} else {
+		pfn_to_map = kargs.pfn;
+	}
+
+	if (mmap_read_lock_killable(current->mm)) {
+		ret = -EINVAL;
+		goto out_put_mm;
+	}
+
+	vma = find_vma(current->mm, kargs.remap_vaddr);
+	if (!vma) {
+		pr_err("remap_page_table: cannot find vma\n");
+		mmap_read_unlock(current->mm);
+		ret = -EINVAL;
+		goto out_put_mm;
+	}
+
+	ret = remap_pfn_range(vma, kargs.remap_vaddr, pfn_to_map, PAGE_SIZE, vma->vm_page_prot);
+	mmap_read_unlock(current->mm);
+
+	if (ret) {
+		pr_err("remap_page_table: remap_pfn_range failed\n");
+	}
+
+out_put_mm:
+	if (target_mm) {
+		mmput(target_mm);
+	}
+
+out_put_task:
+	if (target_task) {
+		//put_task_struct(target_task);
+	}
+
+	return ret;
+}
